<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official MCP C# SDK (hosting + DI + stdio transport). Pulls ModelContextProtocol.Core. -->
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />

    <!-- gRPC client only: Grpc.Net.Client (HTTP/2 over HttpClient). The legacy native
         Grpc.Core 2.46.6 was dropped in Phase 3 — Grpc.Core.Api ships transitively with
         Grpc.Net.Client and provides the interceptor used for the auth token. -->
    <PackageReference Include="Grpc.Net.Client" Version="2.60.0" />
    <PackageReference Include="Google.Protobuf" Version="3.26.1" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\UiAutomationGRPC.Server\protos\uiautomation.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
